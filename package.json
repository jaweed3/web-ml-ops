{
    "name": "ml-prediction-app",
    "version": "1.0.0",
    "description": "Full-Stack ML Prediction Pipeline",
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && python3 app.py",
        "dev:frontend": "cd frontend && npm run dev",
        "build": "cd frontend && npm run build",
        "install:backend": "cd backend && conda run -n mlenv pip install -r requirements.txt",
        "install:frontend": "cd frontend && npm install",
        "start": "npm run dev",
        "test:backend": "cd backend && python3 -m pytest",
        "test:frontend": "cd frontend && npm test",
        "test": "npm run test:backend && npm run test:frontend"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jaweed3/web-ml-ops"
    },
    "keywords": ["machine-learning", "flask", "react", "prediction", "mlops"],
    "author": {"name": "jaweed3"},
    "license": "MIT",
    "devDependencies": {
        "concurrently": "9.1.2"
    }
}